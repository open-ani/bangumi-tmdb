{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "url": {
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "name",
            "sha256",
            "url"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "subjects": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "attemptedAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "retryAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "status": {
            "enum": [
              "matched",
              "pending",
              "error",
              "locked"
            ],
            "type": "string"
          }
        },
        "required": [
          "fingerprint",
          "attemptedAt",
          "retryAt",
          "status",
          "reason"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[1-9]\\d*$",
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "archive",
    "subjects"
  ],
  "type": "object"
}
