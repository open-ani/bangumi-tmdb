{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "repository": {
      "const": "Rhilip/BangumiExtLinker",
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anidb": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "bangumiId": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "imdb": {
            "pattern": "^tt\\d+$",
            "type": "string"
          },
          "tmdb": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "type": {
                    "const": "movie",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "episode": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "id": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "season": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "tv",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "type": "object"
              }
            ]
          },
          "tvdb": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "wikidata": {
            "pattern": "^Q\\d+$",
            "type": "string"
          }
        },
        "required": [
          "bangumiId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "commit",
    "sha256",
    "rows"
  ],
  "type": "object"
}
