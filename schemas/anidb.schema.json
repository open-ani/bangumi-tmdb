{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256",
        "commit"
      ],
      "type": "object"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anidbId": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "bangumiId": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "status": {
            "enum": [
              "agree",
              "partial",
              "conflict",
              "candidate",
              "no-tmdb"
            ],
            "type": "string"
          },
          "targets": {
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "type": {
                      "const": "movie",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "episode": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "episodeEnd": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "id": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "season": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "type": {
                      "const": "tv",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "array"
          },
          "titleStatus": {
            "enum": [
              "matched",
              "different",
              "missing",
              "unavailable"
            ],
            "type": "string"
          },
          "tmdbOffset": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "bangumiId",
          "anidbId",
          "titleStatus",
          "status",
          "targets",
          "tmdbOffset"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "titles": {
      "additionalProperties": false,
      "properties": {
        "lastModified": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256",
        "lastModified"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "titles",
    "mappings",
    "rows"
  ],
  "type": "object"
}
