# TMDB API Read Access Token (v4 bearer token), never an OpenAI API key.
TMDB_READ_TOKEN=
# Optional Bangumi API token; without it the API hides NSFW subjects (they stay in the Archive).
BANGUMI_TOKEN=
# Optional. The runner's subscribed Codex account supplies authentication.
CODEX_MODEL=
CODEX_REASONING=high
CODEX_MAX_SUBJECTS=60
CODEX_CONCURRENCY=4
CODEX_TIMEOUT_MINUTES=8
UPDATE_MAX_MINUTES=60
# Unmapped subjects older than this many days are left to offline batches, not scheduled runs.
UPDATE_SCOPE_DAYS=180
# Optional machine-local cache location (Archive dump, catalog, API overlay, TMDB cache, research logs).
DATASET_CACHE=
